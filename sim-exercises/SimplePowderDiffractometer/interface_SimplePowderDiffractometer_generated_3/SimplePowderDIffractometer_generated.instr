DEFINE INSTRUMENT SimplePowderDIffractometer_generated (
double lambda0 = 1.0, // [AA]  The mean value of  incoming wavelegths (Gaussian distribution)
double dlambda = 0.005, // [AA] Gaussian sigma of incoming wavelength distribution
double coll = 120.0, // [arcmin] horizontal collimation
int container = 0, // [1] When >0 a 2mm thick Al pressed powder can is inserted around the sample
int sample = 0 // [1] 0=Ni, 1=Fe, 2=SiO2, 3=C_diamond, otherwise empty
)
DEPENDENCY " @NCRYSTALFLAGS@"

DECLARE 
%{

double L1=3;
double LC=1;
double sample_radius=0.005;
double sample_height=0.05;
double al_thickness=0.002;
char samplestring[128];
    
%}

INITIALIZE 
%{
// Start of initialize for generated SimplePowderDIffractometer_generated


if (sample==0) {
  sprintf(samplestring,"Ni.laz");
} else if (sample==1) {
  sprintf(samplestring,"Fe.laz");
} else if (sample==2) {
  sprintf(samplestring,"SiO2_quartza.laz");
} else if (sample==3) {
  sprintf(samplestring,"C_diamond.laz");
} else {
  sprintf(samplestring,"NULL");
}


    
%}

TRACE 
COMPONENT Origin = Progress_bar(
 profile = "NULL", percent = 10,
 flag_save = 0, minutes = 0)
AT (0, 0, 0) ABSOLUTE

COMPONENT source = Source_simple(
 radius = 0.1, yheight = 0,
 xwidth = 0, dist = L1,
 focus_xw = 2 * sample_radius + 2 * al_thickness, focus_yh = sample_height + 2 * al_thickness,
 E0 = 0, dE = 0,
 lambda0 = lambda0, dlambda = dlambda,
 flux = 5e10, gauss = 1,
 target_index = 1)
AT (0, 0, 0) RELATIVE Origin
ROTATED (0.0, 0.0, 0.0) RELATIVE Origin

COMPONENT collimator = Collimator_linear(
 xmin = -0.02, xmax = 0.02,
 ymin = -0.05, ymax = 0.05,
 xwidth = 0.2, yheight = 0.2,
 length = 0.2, divergence = coll,
 transmission = 1, divergenceV = 0)
AT (0, 0, LC) RELATIVE source
ROTATED (0.0, 0.0, 0.0) RELATIVE source

COMPONENT entry_side = PowderN(
 reflections = "Al.laz", geometry = "NULL",
 format = { 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 }, radius = sample_radius + al_thickness,
 yheight = sample_height + 2 * al_thickness, xwidth = 0,
 zdepth = 0, thickness = al_thickness,
 pack = 1, Vc = 0,
 sigma_abs = 0, sigma_inc = 0,
 delta_d_d = 0, p_inc = 0.1,
 p_transmit = 0.8, DW = 0,
 nb_atoms = 1, d_omega = 0,
 d_phi = 2, tth_sign = 0,
 p_interact = 0.8, concentric = 1,
 density = 0, weight = 0,
 barns = 1, Strain = 0,
 focus_flip = 0, target_index = 0,
 order = 1)
WHEN (( container > 0 ))
AT (0, 0, L1) RELATIVE source
ROTATED (0.0, 0.0, 0.0) RELATIVE source

COMPONENT sample = PowderN(
 reflections = samplestring, geometry = "NULL",
 format = { 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 }, radius = sample_radius,
 yheight = sample_height, xwidth = 0,
 zdepth = 0, thickness = 0,
 pack = 1, Vc = 0,
 sigma_abs = -1, sigma_inc = -1,
 delta_d_d = 0, p_inc = 0,
 p_transmit = 0.1, DW = 0,
 nb_atoms = 1, d_omega = 0,
 d_phi = 2, tth_sign = 0,
 p_interact = 0.8, concentric = 0,
 density = 0, weight = 0,
 barns = 1, Strain = 0,
 focus_flip = 0, target_index = 0,
 order = 1)
AT (0, 0, L1) RELATIVE source
ROTATED (0.0, 0.0, 0.0) RELATIVE source

COMPONENT exit_side = PowderN(
 reflections = "Al.laz", geometry = "NULL",
 format = { 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 }, radius = sample_radius + al_thickness,
 yheight = sample_height + 2 * al_thickness, xwidth = 0,
 zdepth = 0, thickness = al_thickness,
 pack = 1, Vc = 0,
 sigma_abs = 0, sigma_inc = 0,
 delta_d_d = 0, p_inc = 0.1,
 p_transmit = 0.8, DW = 0,
 nb_atoms = 1, d_omega = 0,
 d_phi = 2, tth_sign = 0,
 p_interact = 0.8, concentric = 0,
 density = 0, weight = 0,
 barns = 1, Strain = 0,
 focus_flip = 0, target_index = 0,
 order = 1)
WHEN (( container > 0 ))
AT (0, 0, L1) RELATIVE source
ROTATED (0.0, 0.0, 0.0) RELATIVE source

COMPONENT Detector = Monitor_nD(
 user0 = "", user1 = "",
 user2 = "", user3 = "",
 user4 = "", user5 = "",
 user6 = "", user7 = "",
 user8 = "", user9 = "",
 xwidth = L1, yheight = 0.20,
 zdepth = 0, xmin = 0,
 xmax = 0, ymin = 0,
 ymax = 0, zmin = 0,
 zmax = 0, bins = 400,
 min = 20, max = 100,
 restore_neutron = 1, radius = 0,
 options = "banana, theta", filename = "detector.dat",
 geometry = "NULL", nowritefile = 0,
 nexus_bins = 0, username0 = "NULL",
 username1 = "NULL", username2 = "NULL",
 username3 = "NULL", username4 = "NULL",
 username5 = "NULL", username6 = "NULL",
 username7 = "NULL", username8 = "NULL",
 username9 = "NULL")
AT (0, 0, 0) RELATIVE sample
ROTATED (0, 0, 180) RELATIVE sample

FINALLY 
%{
// Start of finally for generated SimplePowderDIffractometer_generated
%}

END
